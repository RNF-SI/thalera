# Copier vers import_ebms.env puis renseigner les valeurs.
# Le script charge automatiquement import_ebms.env s'il est présent
# (plus besoin de `source`).

# --- API EBMS / Indicia ---
EBMS_WAREHOUSE_URL=https://warehouse1.indicia.org.uk
EBMS_MEDIA_PREFIX=https://warehouse1.indicia.org.uk/upload/
EBMS_USER=rnfrance
EBMS_SECRET='CHANGE_ME'
EBMS_PROJ_ID=RNFRANCEMOTHS
EBMS_BATCH_SIZE=500

# --- GeoNature PostgreSQL ---
# Exemple :
# GEONATURE_DB_DSN=postgresql://geonatadmin:mdp@localhost:5432/geonature2db
GEONATURE_DB_DSN=

# --- Module Thalera ---
THALERA_MODULE_CODE=thalera
THALERA_ID_DATASET=0
THALERA_ID_DIGITISER=
# Optionnel : cd_nom utilisé si pas de match Taxref (sinon l'occurrence est ignorée)
# THALERA_CD_NOM_FALLBACK=

# Fichier d'état incrémental (metadata.tracking)
THALERA_STATE_FILE=/home/zacharie/dev/monitorings-geonature/thalera/.import_ebms_state.json

# CSV de correspondance taxons EBMS → Taxref
THALERA_TAXONS_CSV=/home/zacharie/dev/thalera/ebms_rnfrance_taxons.csv
